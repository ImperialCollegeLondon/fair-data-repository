input {
  &::placeholder {
    color: @black;
    text-decoration: none;
  }

  &::-webkit-input-placeholder {
    color: @black;
    text-decoration: none;
  }

  &:-ms-input-placeholder {
    color: @black;
    text-decoration: none;
  }

  &::-moz-placeholder {
    color: @black;
    opacity: 1; // Required in Firefox
    text-decoration: none;
  }

  &:-moz-placeholder {
    color: @black;
    opacity: 1;
    text-decoration: none;
  }
}

.ui.input{
  > * {
      background-color: rgba(255, 255, 255, 0.3);
      backdrop-filter: blur(10px);
      border: none;
      border-radius: 0px;
  }
  button {
          border-radius: 0px;
          border-style: unset;
          &:hover {
              background-color: black;
          }

      }
  input {
          color: @black;
          line-height: 1.2rem;
          text-decoration: none;
  }
}
