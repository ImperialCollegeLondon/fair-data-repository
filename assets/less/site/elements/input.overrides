input {
  &::placeholder {
    color: @black;
    text-decoration: none;
  }

  &::-webkit-input-placeholder {
    color: @black;
    text-decoration: none;
  }

  &:-ms-input-placeholder {
    color: @black;
    text-decoration: none;
  }

  &::-moz-placeholder {
    color: @black;
    opacity: 1; // Required in Firefox
    text-decoration: none;
  }

  &:-moz-placeholder {
    color: @black;
    opacity: 1;
    text-decoration: none;
  }
}

.ui.input{
    button {
            border-radius: 0px;
            border: 1px solid @black;
            background-color: @white;
            &:hover {
                background-color: black;
            }

        }
    input {
            color: @black;
            background-color: @white;
            line-height: 1.2rem;
            text-decoration: none;
            border: 1px solid @black;
    }
}
