/* this is hardcoded, because an input is hardcoded in invenio module */
.frontpage-header {
    #header-search-bar {
        .ui.fluid.search.right-angle-search-content{
            .ui.input{
                > * {
                    background-color: rgba(255, 255, 255, 0.3);
                    backdrop-filter: blur(10px);
                    border: none;
                    border-radius: 0px;
                }
                button {
                        border-radius: 0px;
                        border-style: unset;
                        border: none;
                        &:hover {
                            background-color: black;
                        }

                    }
                input {
                        color: @black;
                        line-height: 1.2rem;
                        text-decoration: none;
                }
            }
        }
    }
}
